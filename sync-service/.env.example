# === Sync Agent (agent/run.py) — the current, scheduled push flow ===

# Where Accurate's own .GBK backups appear. Read-only source — the Agent
# never deletes/moves/renames/modifies a backup (brief §8-9). Office
# production default is D:\ (Accurate writes backups there directly) — that
# folder holds backups for OTHER databases too (INTERN 1833, GUDANG2021,
# ...), so the pattern below is mandatory, not optional: never widen this to
# "*.gbk".
BACKUP_PATH=D:\
BACKUP_PATTERN=GUDANGSIG2025*.gbk
# Two size checks this many seconds apart must agree before a backup is
# considered "done writing" and safe to restore (brief §15).
STABILITY_CHECK_SECONDS=120

# Where a picked backup gets restored to before the Agent reads it — NEVER
# GUDANGSIG2025.GDB itself (brief §12). gbak.exe restores here.
STAGING_PATH=D:\01.STOCKWISE\Staging
STAGING_DB_NAME=STAGING.GDB
GBAK_BIN=D:\FirebirdLocal\Firebird_25\bin\gbak.exe

# Firebird connection to the STAGING DB above (not the live production file —
# the path is always STAGING_PATH/STAGING_DB_NAME above, there is no separate
# FIREBIRD_DATABASE setting, on purpose: one fact, one source of truth).
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
# A LOCAL Firebird login the Agent's own staging engine understands — NOT an
# Accurate/production credential. Whatever user created the local Firebird
# install (often SYSDBA on a fresh instance) is fine here.
FIREBIRD_USER=
FIREBIRD_PASSWORD=
FIREBIRD_CLIENT_LIB=D:\FirebirdLocal\Firebird_25\bin\fbclient.dll

# Stockwise Laravel API the Agent pushes to (POST /api/agent/sync/*) — never
# a direct MySQL connection (brief §6). Dev: local Laravel on :8001.
# Production: the Hostinger domain, over HTTPS.
API_URL=http://127.0.0.1:8001/api
# From `php artisan stockwise:agent-token` — shown once, paste it here only.
API_TOKEN=
API_TIMEOUT_SECONDS=30
# The .../complete call alone runs Laravel's full mapping/upsert pass over
# every staged row (confirmed ~90s for ~20k records) — needs a much longer
# timeout than the small per-chunk pushes above.
API_COMPLETE_TIMEOUT_SECONDS=310

# Final schedule (brief §10) — do not add 20:00 / 21:30 / 22:00 / 22:30; the
# office server auto-shuts down at 22:00 (brief §11/§44).
SYNC_TIMES=04:00,10:30,20:30

AGENT_STATE_PATH=D:\01.STOCKWISE\Config\agent_state.sqlite
AGENT_LOG_PATH=D:\01.STOCKWISE\Logs

# === Legacy direct-MySQL path (sync/initial_sync.py, database/mysql_client.py) ===
# Deprecated — kept only until the Agent flow above is validated end-to-end
# against a real Firebird server, then removed. Not used by `agent/run.py`.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stockwise
MYSQL_USER=root
MYSQL_PASSWORD=
